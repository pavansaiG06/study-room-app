{
  "name": "study-room-app",
  "version": "2.0.0",
  "description": "3D Workspace & Study Room Application with Live Video, Audio, Screen Share & Real-time Collaboration",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "install:all": "npm install --include=dev && npm --prefix client install --include=dev",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "peer": "^1.0.2",
    "socket.io": "^4.7.5",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
