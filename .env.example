# Copy this file to ".env" for local or production configuration!
# (Note: the server loads ".env", not ".env.example")

# Server Port (Render injects PORT automatically in production)
PORT=3000

# JWT Authentication Secret (set a strong random string in production)
JWT_SECRET=replace-with-a-secure-random-secret-key

# ==========================================================
# DATABASE CONFIGURATION
# - Option 1 (Render / Cloud): Set BOTH Turso variables below
# - Option 2 (Local / Oracle VPS): Leave Turso blank to use local SQLite
# ==========================================================
# TURSO_DATABASE_URL=libsql://studyhub-yourname.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Local SQLite fallback path (used only when TURSO_DATABASE_URL is not set)
DATABASE_PATH=./data/studyhub.db

# Platform Super-Admin Email
ADMIN_EMAIL=saip73535@gmail.com

# Optional Custom TURN Server (for strict corporate/college NATs)
# TURN_URL=turn:standard.relay.metered.ca:80
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential
